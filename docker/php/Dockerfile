FROM php:8.4-fpm-alpine

# The host UID/GID, so files created inside the container (cache, migrations,
# classes generated by bundles) belong to you rather than to root.
ARG UID=1000
ARG GID=1000

# Runtime: composer needs git/unzip, shadow provides usermod (busybox has none).
# icu-data-full is the complete locale data: alpine installs icu-data-en by
# default, and intl then silently formats dates in English even under ru_RU.
# icu-libs is listed explicitly, or it would leave together with icu-dev on
# `apk del .build-deps`.
#
# The second apk add holds everything needed only while the extensions compile:
# in a separate virtual group, so it can be dropped in one command instead of
# carrying a compiler and headers into the finished image.
RUN apk add --no-cache git unzip shadow icu-libs icu-data-full \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev linux-headers \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql intl opcache \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug \
    && pecl clear-cache \
    && apk del .build-deps

# www-data in alpine has uid 82 — move it to the host uid/gid.
RUN groupmod -o -g "${GID}" www-data \
    && usermod  -o -u "${UID}" -g "${GID}" www-data

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY php.ini /usr/local/etc/php/conf.d/99-app.ini
COPY xdebug.ini /usr/local/etc/php/conf.d/99-xdebug.ini

WORKDIR /var/www/app

# The composer cache lives in a volume, so `composer install` downloads once.
ENV COMPOSER_HOME=/var/www/.composer
RUN mkdir -p "$COMPOSER_HOME" && chown www-data:www-data /var/www/.composer
