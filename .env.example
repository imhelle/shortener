COMPOSE_PROJECT_NAME=shortener

# Host UID/GID — so files from the container are not root:root. `id -u`, `id -g`
UID=1000
GID=1000

NGINX_PORT=8080
MYSQL_PORT=13306

MYSQL_DATABASE=shortener
MYSQL_USER=shortener
MYSQL_PASSWORD=shortener
MYSQL_ROOT_PASSWORD=root

# off — fast; debug — for breakpoints in PhpStorm
XDEBUG_MODE=off

# Symfony's own signing key (UriSigner and anything the framework signs itself).
# Not the JWT signing key — different purposes, different blast radius.
# Generate: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
