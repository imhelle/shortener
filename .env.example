COMPOSE_PROJECT_NAME=shortener

# UID/GID хоста — чтобы файлы из контейнера не были root:root. `id -u`, `id -g`
UID=1000
GID=1000

NGINX_PORT=8080
MYSQL_PORT=13306

MYSQL_DATABASE=shortener
MYSQL_USER=shortener
MYSQL_PASSWORD=shortener
MYSQL_ROOT_PASSWORD=root

# off — быстро; debug — для точек останова в PhpStorm
XDEBUG_MODE=off
