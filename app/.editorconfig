# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{compose.yaml,compose.*.yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# PhpStorm-specific properties (ij_php_*): other editors ignore them.
[*.php]
# "Keep" means trim the extras on reformat, never add blank lines.
ij_php_keep_blank_lines_in_code = 1
ij_php_keep_blank_lines_in_declarations = 1
ij_php_keep_blank_lines_before_right_brace = 0
ij_php_blank_lines_after_class_header = 0

# We do not force wrapping (that would split short signatures too), but once
# the line is broken by hand, PER-CS layout is enforced: "(" ends the line,
# ")" gets its own line, followed by " {".
ij_php_method_parameters_wrap = normal
ij_php_method_parameters_new_line_after_left_paren = true
ij_php_method_parameters_right_paren_on_new_line = true

# PER-CS keeps one space between type and name; column alignment drifts
# every time a type name changes length, which pollutes diffs.
ij_php_align_multiline_parameters = false
